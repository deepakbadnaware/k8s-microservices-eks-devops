# Build with the name and tag
docker build -t myorg/myapp-backend:1.0.0 ./backend
docker build -t myorg/myapp-frontend:1.0.0 ./frontend

# Log in
docker login

# Push
docker push myorg/myapp-backend:1.0.0
docker push myorg/myapp-frontend:1.0.0



minikube addons enable metrics-server
kubectl top pods -n my-app


